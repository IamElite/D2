# ============================================================
#  D2 — config.env template
#
#  Copy karo:   cp .env.example config.env
#  phir values bharo.  config.env .gitignore me hai — commit nahi hoga.
#
#  VPS pe:  docker compose is file ko env_file ki tarah padhta hai.
#  Heroku pe: yeh values app ke Config Vars me daalo (yahan PORT platform deta hai).
#
#  Yeh sirf zaroori + deploy-critical vars hain. Poore ~132 optional vars
#  /botsettings se ya bot/helper/ext_utils/help_messages.py me documented hain.
# ============================================================


# ---------- ZAROORI — inke bina bot start nahi hoga ----------
BOT_TOKEN=123456789:AAH-your-bot-token-here
TELEGRAM_API=1234567
TELEGRAM_HASH=0123456789abcdef0123456789abcdef
OWNER_ID=123456789
DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/DATABASE


# ---------- DEPLOY — VPS pe zaroori, Heroku pe platform khud deta hai ----------
# D2 web server (file selector) ka port — YAHII SOURCE OF TRUTH HAI.
# bot/__init__.py: WEB_SERVER_PORT = PORT or BASE_URL_PORT
# Isliye VPS/Docker pe alag se PORT dene ki zaroorat NAHI. Default 80.
# Galat (non-integer ya 1-65535 ke bahar) value pe bot clear error ke saath exit karta hai.
BASE_URL_PORT=8080

# Woh address jahan se web server browser me khule. VPS pe apna IP/domain daalo.
# Port BASE_URL_PORT ke barabar hona chahiye.
# ⚠️ BASE_URL khaali hua to web server start hi nahi hoga (boot gate: PORT or BASE_URL).
BASE_URL=http://YOUR_VPS_IP:8080

# PORT sirf Heroku ke liye hai — wahan platform khud set karta hai.
# VPS/Docker pe yeh MAT set karo: set hone par yeh BASE_URL_PORT pe precedence
# le lega aur mapping confuse ho jaayegi.
#PORT=

# Downloads ki jagah. docker-compose.yml isi path ko ./downloads pe mount karta hai.
DOWNLOAD_DIR=/usr/src/app/downloads/


# ---------- CODE UPDATE — /restart pe yahi repo/branch pull hota hai ----------
UPSTREAM_REPO=https://github.com/IamElite/D2
UPSTREAM_BRANCH=arnv1


# ---------- OPTIONAL — sabse zyada kaam aane wale ----------
# Kaun chat/command use kar sakta hai (space-separated chat ids)
AUTHORIZED_CHATS=
SUDO_USERS=

# Command suffix, jaise "ml" -> /mirror ml. Khaali = bina suffix.
CMD_SUFFIX=

# Upload destination: 'gd' (Google Drive), 'rc' (rclone), 'ddl', ya khaali = Telegram
DEFAULT_UPLOAD=
GDRIVE_ID=
RCLONE_PATH=

# Status message kitne second me update ho. Chhota = zyada CPU + Telegram flood risk.
STATUS_UPDATE_INTERVAL=6

TIMEZONE=Asia/Kolkata

# Naya task aane pe status/links delete karo
DELETE_LINKS=True

# Ek saath kitne task chalein (VPS pe bada, chhote dyno pe chhota rakho)
BOT_MAX_TASKS=
USER_MAX_TASKS=


# ---------- PORTS — inhe aapas me mat uljhana ----------
# D2 web server (file selector)  = BASE_URL_PORT   <-- upar set kiya, yahi expose hota hai
# rclone serve (file links)      = RCLONE_SERVE_PORT (default 8080) — alag cheez
# Aria2 RPC                      = 6800  (sirf container ke andar, expose nahi karna)
# qBittorrent WebUI              = 8090  (sirf container ke andar, expose nahi karna)
# RCLONE_SERVE_PORT=8080


# ---------- PERFORMANCE — chhote dyno vs bada VPS ----------
# Heroku jaisi chhoti machine pe conservative profile achha hai.
# Bade VPS pe tez download chahiye to yeh 'safe' se hatkar default rakho.
# ARIA2_PROFILE=safe
